+.checkbox-item input { width: 16px; height: 16px; flex-shrink: 0; }
 .modal-footer { height: 56px; flex-shrink: 0; display: flex; align-items: center; justify-content: flex-end; gap: var(--sp-sm); padding: 0 20px; border-top: 1px solid var(--color-border); }
 
 /* ---------- 등록 폼 화면(SCR-013) ---------- */
@@ -402,4 +417,16 @@ table.data-table tr.row-clickable { cursor: pointer; }
