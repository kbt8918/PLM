 .flow-node-label { font-size: 12px; font-weight: 600; line-height: 15px; }
+
+/* ---------- 토스트 알림 (design_handoff_생기포털 README "조회 완료 시 화면 우상단 토스트" 공통 동작) ---------- */
+#toast-root { position: fixed; z-index: 200; inset: auto; bottom: 24px; right: 24px; pointer-events: none; }
+.toast {
+  display: flex; align-items: center; gap: var(--sp-sm); background: #1F2937; color: #fff;
+  padding: 10px 16px; border-radius: 8px; font-size: 13px; box-shadow: 0 8px 24px rgba(0,0,0,0.25);
+}
